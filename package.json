{
  "name": "baleen",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Extension Chrome pour structurer et comparer des fiches produit.",
  "repository": {
    "type": "git",
    "url": "https://github.com/delhombre/baleen.git"
  },
  "homepage": "https://github.com/delhombre/baleen",
  "bugs": {
    "url": "https://github.com/delhombre/baleen/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "wxt build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:unit": "vitest run",
    "audit:manifest": "node scripts/audit-manifest.mjs",
    "test:e2e": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm audit:manifest && pnpm test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "linkedom": "0.18.13",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10",
    "wxt": "0.21.4"
  }
}
